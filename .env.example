DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rakitara?schema=public
APP_ORIGIN=http://localhost:3000
ADMIN_USERNAME=owner
# Generate using bun run api:hash-password; never store the plaintext password.
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
# Only set for the actual trusted reverse-proxy IPs/subnets. Never use true.
# TRUST_PROXY=loopback
# NODE_ENV=production
# Explicit isolated test database. Never point this at production.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rakitara_test
